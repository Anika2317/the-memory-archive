{
  "name": "the-memory-archive",
  "private": true,
  "scripts": {
    "build": "sass --no-source-map --style=compressed scss/main.scss css/main.css",
    "watch": "sass --no-source-map --watch scss/main.scss css/main.css",
    "format": "prettier --write index.html js scss"
  },
  "devDependencies": {
    "prettier": "3.3.3",
    "sass": "1.104.0"
  }
}
